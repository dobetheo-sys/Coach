+export const SESSIONSCALE_DEPART = rule("O-113", "facteur d'échelle de la TAILLE DE NAISSANCE des blocs à la première semaine du plan — valeur en cours de calibration (fiche 51)", 0.8);
+
+/**
+ * O-113 (fiche 51) — LE FACTEUR DE TAILLE DE NAISSANCE DES BLOCS À LA SEMAINE `wk` (index 0).
+ * Pur.
+ *
+ * Même patron que `capScaleAtWeek` (O-77, fiche 48) et que `swimSessionCapAtWeek` (O-56) : la
+ * POSITION dans le plan, jamais l'ambition DÉCLARÉE. `plein` porte ce qui reste légitimement
+ * multiplicatif — récupération dégradée (sommeil court, charge de vie) et facteur de charge
+ * blessure/âge —, jamais le rapport à l'enveloppe déclarée, qui est précisément la cause
+ * d'O-113.
+ */
+export function sessionScaleAtWeek(phases: Phase[], weeks: number, wk: number, plein: number): number {
+  const pic = phases.find((p) => p.id === "peak");
+  const taper = phases.find((p) => p.id === "taper");
+  const kPic = pic ? pic.start : taper ? Math.max(1, taper.start - 1) : Math.max(1, weeks - 1);
+  const p = kPic > 0 ? Math.min(1, Math.max(0, wk / kPic)) : 1;
+  return (SESSIONSCALE_DEPART + (1 - SESSIONSCALE_DEPART) * p) * plein;
+}
+
+/** O-113 — ce qui reste multiplicatif dans la taille de naissance : la SÉCURITÉ, jamais l'ambition. */
+export function sessionScalePlein(r: { volLimits?: { recup?: number }; loadFactor?: number }): number {
+  const recup = r.volLimits?.recup ?? 1;
+  const lf = typeof r.loadFactor === "number" && r.loadFactor < 1 ? r.loadFactor : 1;
+  return recup * lf;
+}
